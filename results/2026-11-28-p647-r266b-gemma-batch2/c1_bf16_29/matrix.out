PROMPT_ORACLE served=g3 engine_ntok=40 probe_ntok=40 match=True
FORMAT g3 ntok=40 prompt='<bos><start_of_turn>user\nWhat is the capital of France? Answer with just the city name.<end_of_turn>\n<start_of_turn>model\n'
