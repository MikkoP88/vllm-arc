+/*
+ * vllm-arc patch: fp8 (e4m3) wire format for the BMG TP2 large-allreduce ring.
+ *
+ * Replaces the fp16 wire of allreduce_large_su_ring_write_multi_kernel for
+ * dtype=float16, reduction=sum, node size==2, count/2 >= min-count. Slot
+ * geometry is inherited from the stock tmp-buf carve (chunk_size bytes per
+ * slot); each slot transports a chunk twice: the peer-bound quantized input
+ * in the first half and the peer-bound quantized partial sum in the second
+ * half. A 16-byte scale area lives at the tail of slot 0:
+ *   slot0[chunk_size-16] my amax     (written by K1, read by K2/K3)
+ *   slot0[chunk_size-12] peer scale  (written by peer's K2, read by K3/K4)
+ *   slot0[chunk_size-8]  res scale   (written by K3, read by K4/K5)
+ * res_scale = 2*max(s_local, s_peer) bounds |a+b| by construction; both ranks
+ * compute it identically from barrier-ordered values. Output halves on both
+ * ranks carry exactly one e4m3 round trip (out1 = dequant(quant(sum))), so
+ * rank-to-rank recv contents match bit-for-bit up to the local sum itself.
+ * Per-chunk sequence K2 -> barrier -> K4 keeps the stock pipeline slot
+ * rotation and barrier count (K3 rides between chunk 0's barrier and K4).
+ * Graph-capture safe: no host reads of device data unless FP8_STATS=1
+ * (declared diagnostic perturbation).
+ */
+
+#pragma once
+#include "oneapi/ccl.hpp"
+#include "common/global/global.hpp"
+
+#if defined(CCL_ENABLE_ZE) || defined(CCL_ENABLE_SYCL)
+#include "coll/algorithms/utils/sycl_kernels.hpp"
+#include "coll/algorithms/reduce_scatter/sycl/reduce_scatter_large_sycl_ring.hpp"
+#include "coll/algorithms/allreduce/sycl/allreduce_sycl.hpp"
+#include "coll/algorithms/utils/sycl_coll_base.hpp"
+#include "comm/comm.hpp"
+
+/* e4m3 constants: largest finite value 448, no infinity. */
+#define FP8AR_E4M3_MAX 448.0f
+
+/* fp32 -> e4m3 (round-to-nearest-even, saturating). The value passes through
+ * fp16 first (one extra rounding step near ties; measured end-to-end by the
+ * quality ladder, see results/2026-11-05-p624-fp8-ar). fp16 subnormals flush
+ * to zero, matching the e4m3 subnormal floor of 2^-9. */
+static inline uint8_t fp8ar_float_to_e4m3(float v) {
+    sycl::half h = (sycl::half)v;
+    uint16_t bits = sycl::bit_cast<uint16_t>(h);
+    uint16_t sign = (uint16_t)((bits & 0x8000u) >> 8);
+    uint16_t exp = (bits >> 10) & 0x1Fu;
+    uint16_t man = bits & 0x3FFu;
+    if (exp == 0x1Fu) {
+        /* inf saturates, NaN stays NaN */
+        return (uint8_t)(sign | (man ? 0x7Fu : 0x7Eu));
+    }
+    if (exp == 0) {
+        /* zero or fp16 subnormal (|v| < 2^-14 << 2^-9 e4m3 subnormal floor) */
+        return (uint8_t)sign;
+    }
+    /* re-bias (e5:m10 -> e4:m3) with RTNE on the concatenated 15-bit field */
+    uint32_t concat = ((uint32_t)exp << 10) | man;
+    uint32_t rounded = (concat + 0x40u + ((concat >> 7) & 1u)) >> 7;
+    if (rounded >= 0x7Fu) {
+        rounded = 0x7Eu; /* >= 464 would round to the NaN pattern: saturate */
+    }
+    return (uint8_t)(sign | rounded);
+}
+
+/* e4m3 -> fp32, exact. */
+static inline float fp8ar_e4m3_to_float(uint8_t q) {
+    if ((q & 0x7Fu) == 0x7Fu) {
+        return sycl::bit_cast<float>(0x7fc00000u); /* NaN */
+    }
+    uint32_t e = (q >> 3) & 0xFu;
+    uint32_t m = q & 0x7u;
+    float mag = (e == 0) ? (float)m * 0.001953125f /* m * 2^-9 */
+                         : sycl::ldexp((float)(8u + m), (int)e - 10);
+    return (q & 0x80u) ? -mag : mag;
+}
+
+/* K1: amax over the outgoing (peer-owned) half of send_buf. */
+template <typename T>
+void fp8ar_amax_kernel(const void *send_half, size_t recv_count, float *amax_ptr) {
+    sycl::atomic_ref<float,
+                     sycl::memory_order::relaxed,
+                     sycl::memory_scope::device,
+                     sycl::access::address_space::global_space>
+        amax_atom(*amax_ptr);
+    const sycl::nd_item<1> it = syclext::this_work_item::get_nd_item<1>();
+    const size_t num_threads = it.get_global_range(0);
+    const size_t gid = it.get_global_linear_id();
+    for (size_t offset = 0; offset < recv_count; offset += num_threads) {
+        const size_t idx = gid + offset;
+        if (idx < recv_count) {
+            amax_atom.fetch_max(sycl::fabs((float)((const T *)send_half)[idx]));
+        }
+    }
+}
+
+/* K2: quantize a chunk of the outgoing half into the peer's slot (first half
+ * of the slot); the first thread of chunk 0 also publishes my scale into the
+ * peer's slot-0 scale area. */
+template <typename T>
+void fp8ar_quant_kernel(const void *send_buf,
+                        size_t send_half_off, /* element offset of outgoing half */
+                        size_t chunk_elem_off,
+                        size_t data_count,
+                        uint8_t *remote_slot,
+                        float *my_amax_ptr,   /* my slot0 tail [chunk_size-16] */
+                        float *peer_scale_ptr, /* peer slot0 tail [chunk_size-12] */
+                        size_t chunk_id) {
+    const sycl::nd_item<1> it = syclext::this_work_item::get_nd_item<1>();
+    const size_t num_threads = it.get_global_range(0);
+    const size_t gid = it.get_global_linear_id();
+    const float amax = *my_amax_ptr;
+    const float mul = (amax > 0.0f) ? FP8AR_E4M3_MAX / amax : 0.0f;
+    const T *src = (const T *)send_buf + send_half_off + chunk_elem_off;
+    for (size_t offset = 0; offset < data_count; offset += num_threads) {
+        const size_t idx = gid + offset;
+        if (idx < data_count) {
+            remote_slot[idx] = fp8ar_float_to_e4m3((float)src[idx] * mul);
+        }
+    }
+    if (gid == 0 && chunk_id == 0) {
+        *peer_scale_ptr = amax / FP8AR_E4M3_MAX;
+    }
+}
+
+/* K3: res_scale = 2 * max(s_local, s_peer), written once per message. */
+static inline void fp8ar_res_kernel(float *my_amax_ptr, float *peer_scale_ptr, float *res_ptr) {
+    const float s_local = (*my_amax_ptr) / FP8AR_E4M3_MAX;
+    const float s_peer = *peer_scale_ptr;
+    float res = 2.0f * (s_local > s_peer ? s_local : s_peer);
+    *res_ptr = (res > 0.0f) ? res : 1.0f; /* all-zero message: values are 0 anyway */
+}
+
+/* K4: reduce my chunk (fp16) with the peer's quantized chunk, emit the fp16
+ * result locally and the quantized result into the peer's slot tail. */
+template <typename T>
+void fp8ar_reduce_kernel(void *out1,        /* fp16, my recv chunk */
+                         const void *in1,   /* fp16, my send chunk */
+                         const uint8_t *in2, /* e4m3, peer's quantized chunk */
+                         uint8_t *out2,     /* e4m3, peer's slot tail */
+                         size_t data_count,
+                         float *peer_scale_ptr,
+                         float *res_ptr) {
+    const sycl::nd_item<1> it = syclext::this_work_item::get_nd_item<1>();
+    const size_t num_threads = it.get_global_range(0);
+    const size_t gid = it.get_global_linear_id();
+    const float s_peer = *peer_scale_ptr;
+    const float res = *res_ptr;
+    const float inv_res = 1.0f / res;
+    T *dst1 = (T *)out1;
+    const T *src1 = (const T *)in1;
+    for (size_t offset = 0; offset < data_count; offset += num_threads) {
+        const size_t idx = gid + offset;
+        if (idx < data_count) {
+            const float sum = (float)src1[idx] + fp8ar_e4m3_to_float(in2[idx]) * s_peer;
+            const uint8_t q = fp8ar_float_to_e4m3(sum * inv_res);
+            out2[idx] = q;
+            dst1[idx] = (T)(fp8ar_e4m3_to_float(q) * res);
+        }
+    }
+}
+
+/* K5: dequantize the peer's quantized result from my slot tail into my recv. */
+template <typename T>
+void fp8ar_dequant_kernel(const uint8_t *src, /* e4m3, my slot tail */
+                          void *dst,          /* fp16, my recv chunk */
+                          size_t data_count,
+                          float *res_ptr) {
+    const sycl::nd_item<1> it = syclext::this_work_item::get_nd_item<1>();
+    const size_t num_threads = it.get_global_range(0);
+    const size_t gid = it.get_global_linear_id();
+    const float res = *res_ptr;
+    T *out = (T *)dst;
+    for (size_t offset = 0; offset < data_count; offset += num_threads) {
+        const size_t idx = gid + offset;
+        if (idx < data_count) {
+            out[idx] = (T)(fp8ar_e4m3_to_float(src[idx]) * res);
+        }
+    }
+}
+
+/* Host entry: mirrors allreduce_large_su_ring() for the N==2 fp16 SUM case.
+ * Guarded by the caller (allreduce_large_sycl.cpp, BMG no-tmp branch). */
+template <typename T>
+sycl::event allreduce_large_fp8_ring(const void *send_buf,
+                                     void *recv_buf,
+                                     size_t count,
+                                     ccl::datatype dtype,
+                                     ccl::reduction reduction,
+                                     ccl_comm *comm,
+                                     ccl_stream *global_stream,
+                                     sycl_ptrs_type &sycl_ptrs,
+                                     const ccl::vector_class<ccl::event> &deps) {
+    const bool is_cpu_barrier = ccl::global_data::env().sycl_ccl_barrier;
+    (void)dtype;
+    (void)reduction;
+    assert(reduction == ccl::reduction::sum);
+    sycl::queue q = global_stream->get_native_stream();
+
+    std::shared_ptr<ccl_comm> node_comm = comm->get_node_comm();
+    const int N = node_comm->size();
+    const int rank = node_comm->rank();
+    assert(N == 2 && count % 2 == 0);
+
+    const size_t count_per_rank = count / N;
+    const size_t recv_count = count_per_rank;
+    const int s = (rank + N - 1) % N; /* owner of my outgoing half */
+    const int peer_rank = (rank + 1) % N;
+
+    size_t num_threads = ccl::global_data::env().sycl_num_threads;
+
+    sycl::device device = q.get_device();
+    const size_t max_work_group_size = device.get_info<sycl::info::device::max_work_group_size>();
+    const size_t work_group_size = ccl::global_data::env().sycl_work_group_size;
+    assert(work_group_size > 0 && work_group_size <= max_work_group_size);
+
+    /* stock tmp-buf carve */
+    const int pipeline_size = std::max(N, ccl_large_tmp_bufs::buf_count);
+    const size_t chunk_size =
+        ccl::global_data::env().sycl_tmp_buf_size / pipeline_size / sizeof(message_t) *
+        sizeof(message_t);
+    const size_t half_bytes = chunk_size / 2;
+    /* 16-byte scale area at each slot tail halves the usable element count */
+    const size_t fp8_chunk_elems = half_bytes - 16;
+    const size_t num_chunks =
+        recv_count / fp8_chunk_elems + (recv_count % fp8_chunk_elems != 0);
+
+    std::array<void *, ARC_MAX_NUM> work_bufs;
+    std::array<void *, ARC_MAX_NUM> remote_work_bufs;
+    work_bufs[0] = get_tmp_buf(0, comm);
+    remote_work_bufs[0] = get_remote_node_tmp_buf(0, comm)[peer_rank];
+    for (int i = 1; i < pipeline_size; i++) {
+        work_bufs[i] = (char *)work_bufs[i - 1] + chunk_size;
+        remote_work_bufs[i] = (char *)remote_work_bufs[i - 1] + chunk_size;
+    }
+
+    /* slot-0 scale area */
+    float *my_amax_ptr = (float *)((char *)work_bufs[0] + chunk_size - 16);
+    float *peer_scale_ptr = (float *)((char *)work_bufs[0] + chunk_size - 12);
+    float *res_ptr = (float *)((char *)work_bufs[0] + chunk_size - 8);
+    float *remote_scale_ptr = (float *)((char *)remote_work_bufs[0] + chunk_size - 12);
+
+    std::vector<sycl::event> dep_events = get_sycl_events(deps);
+    sycl::event work_event;
+
+    invoke_barrier(node_comm, q, dep_events, is_cpu_barrier);
+
+    auto launch_threads = [&](size_t elem_count) {
+        size_t kernel_threads = elem_count;
+        if (num_threads) {
+            kernel_threads = std::min(kernel_threads, num_threads);
+        }
+        return ((kernel_threads + work_group_size - 1) / work_group_size) * work_group_size;
+    };
+
+    /* K1: amax of my outgoing half */
+    {
+        const void *send_half = (const char *)send_buf + s * recv_count * sizeof(T);
+        const size_t kernel_size = launch_threads(recv_count);
+        q.memset(my_amax_ptr, 0, sizeof(float));
+        q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                           fp8ar_amax_kernel<T>(send_half, recv_count, my_amax_ptr);
+                       });
+    }
+
+    /* chunk loop: K2 -> p2p barrier -> (K3 once) -> K4 */
+    for (size_t nc = 0; nc < num_chunks; nc++) {
+        const size_t chunk_elem_off = nc * fp8_chunk_elems;
+        const size_t data_count =
+            (nc < recv_count / fp8_chunk_elems) ? fp8_chunk_elems
+                                                : recv_count % fp8_chunk_elems;
+        const int slot = nc % pipeline_size;
+        const size_t kernel_size = launch_threads(data_count);
+
+        uint8_t *remote_slot = (uint8_t *)remote_work_bufs[slot];
+        q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                           fp8ar_quant_kernel<T>(send_buf,
+                                                 s * recv_count,
+                                                 chunk_elem_off,
+                                                 data_count,
+                                                 remote_slot,
+                                                 my_amax_ptr,
+                                                 remote_scale_ptr,
+                                                 nc);
+                       });
+
+        invoke_p2p_barrier(node_comm, q, {}, is_cpu_barrier);
+
+        if (nc == 0) {
+            q.parallel_for(sycl::nd_range<1>(work_group_size, work_group_size),
+                           [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                               if (it.get_global_linear_id() == 0) {
+                                   fp8ar_res_kernel(my_amax_ptr, peer_scale_ptr, res_ptr);
+                               }
+                           });
+        }
+
+        T *out1 = (T *)recv_buf + rank * recv_count + chunk_elem_off;
+        const T *in1 = (const T *)send_buf + rank * recv_count + chunk_elem_off;
+        const uint8_t *in2 = (const uint8_t *)work_bufs[slot];
+        uint8_t *out2 = (uint8_t *)remote_work_bufs[slot] + half_bytes;
+        q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                           fp8ar_reduce_kernel<T>(out1,
+                                                  in1,
+                                                  in2,
+                                                  out2,
+                                                  data_count,
+                                                  peer_scale_ptr,
+                                                  res_ptr);
+                       });
+    }
+
+    invoke_p2p_barrier(node_comm, q, {}, is_cpu_barrier);
+
+    /* K5: dequantize peer results from my slot tails into my recv */
+    for (size_t nc = 0; nc < num_chunks; nc++) {
+        const size_t chunk_elem_off = nc * fp8_chunk_elems;
+        const size_t data_count =
+            (nc < recv_count / fp8_chunk_elems) ? fp8_chunk_elems
+                                                : recv_count % fp8_chunk_elems;
+        const int slot = nc % pipeline_size;
+        const size_t kernel_size = launch_threads(data_count);
+
+        const uint8_t *src = (const uint8_t *)work_bufs[slot] + half_bytes;
+        T *dst = (T *)recv_buf + peer_rank * recv_count + chunk_elem_off;
+        q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                           fp8ar_dequant_kernel<T>(src, dst, data_count, res_ptr);
+                       });
+    }
+
+    invoke_p2p_barrier(node_comm, q, {}, is_cpu_barrier);
+
+    if (ccl::global_data::env().sycl_allreduce_fp8_stats) {
+        /* diagnostic only: synchronizes the queue (declared perturbation) */
+        float stats[3];
+        q.memcpy(stats, my_amax_ptr, 3 * sizeof(float)).wait();
+        LOG_INFO("fp8 allreduce: count ",
+                 count,
+                 ", chunks ",
+                 num_chunks,
+                 ", amax ",
+                 stats[0],
+                 ", peer scale ",
+                 stats[1],
+                 ", res scale ",
+                 stats[2]);
+    }
+
+    {
+        std::vector<sycl::event> evts;
+        work_event = submit_wait_on_events(q, evts);
+    }
+
+    return work_event;
+}
+
+#endif // defined(CCL_ENABLE_ZE) || defined(CCL_ENABLE_SYCL)
