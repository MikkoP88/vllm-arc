+/* r100 probe kernels: wire-rate measurement over the peer IPC mapping.
+ * v4's remote traffic is 100% STORES (K2 quant + K4 result, ~9.6 GB/s at
+ * u32 width); a read-based v5 (each rank reads the peer's deposits instead
+ * of receiving writes) moves the same bytes in the opposite direction and
+ * is justified only if remote LOADS outrun remote STORES. Widths 4/8/16
+ * bytes per element test whether the u32 packing law is the fabric limit
+ * or an instruction-issue limit. Loads accumulate into a device scratch so
+ * they cannot be elided. */
+static void fp8ar_probe_write_kernel(uint8_t *dst,
+                                     size_t bytes,
+                                     size_t width,
+                                     uint32_t seed) {
+    const sycl::nd_item<1> it = syclext::this_work_item::get_nd_item<1>();
+    const size_t num_threads = it.get_global_range(0);
+    const size_t gid = it.get_global_linear_id();
+    const size_t elems = bytes / width;
+    if (width == 4) {
+        uint32_t *p = (uint32_t *)dst;
+        for (size_t off = 0; off < elems; off += num_threads) {
+            const size_t i = gid + off;
+            if (i < elems) p[i] = seed ^ (uint32_t)i;
+        }
+    } else if (width == 8) {
+        uint64_t *p = (uint64_t *)dst;
+        for (size_t off = 0; off < elems; off += num_threads) {
+            const size_t i = gid + off;
+            if (i < elems) p[i] = ((uint64_t)seed << 32) ^ (uint64_t)i;
+        }
+    } else {
+        sycl::uint4 *p = (sycl::uint4 *)dst;
+        const sycl::uint4 v{ seed, 0x11111111u, 0x22222222u, 0x33333333u };
+        for (size_t off = 0; off < elems; off += num_threads) {
+            const size_t i = gid + off;
+            if (i < elems) p[i] = v;
+        }
+    }
+}
+
+static void fp8ar_probe_read_kernel(const uint8_t *src,
+                                    size_t bytes,
+                                    size_t width,
+                                    uint32_t *scratch) {
+    const sycl::nd_item<1> it = syclext::this_work_item::get_nd_item<1>();
+    const size_t num_threads = it.get_global_range(0);
+    const size_t gid = it.get_global_linear_id();
+    const size_t elems = bytes / width;
+    uint64_t acc = 0;
+    if (width == 4) {
+        const uint32_t *p = (const uint32_t *)src;
+        for (size_t off = 0; off < elems; off += num_threads) {
+            const size_t i = gid + off;
+            if (i < elems) acc += p[i];
+        }
+    } else if (width == 8) {
+        const uint64_t *p = (const uint64_t *)src;
+        for (size_t off = 0; off < elems; off += num_threads) {
+            const size_t i = gid + off;
+            if (i < elems) acc += p[i];
+        }
+    } else {
+        const sycl::uint4 *p = (const sycl::uint4 *)src;
+        for (size_t off = 0; off < elems; off += num_threads) {
+            const size_t i = gid + off;
+            if (i < elems) {
+                const sycl::uint4 v = p[i];
+                acc += (uint64_t)v[0] + v[1] + v[2] + v[3];
+            }
+        }
+    }
+    if (acc == 0xdeadbeefdeadbeefULL) {
+        *scratch = (uint32_t)acc; /* never taken: defeats elision */
+    }
+}
+
+static void fp8ar_probe_rw_kernel(uint8_t *dst,
+                                  const uint8_t *src,
+                                  size_t bytes, /* per direction */
+                                  uint32_t seed) {
+    const sycl::nd_item<1> it = syclext::this_work_item::get_nd_item<1>();
+    const size_t num_threads = it.get_global_range(0);
+    const size_t gid = it.get_global_linear_id();
+    const bool writer = (gid & 1) == 0;
+    const size_t lane = gid >> 1; /* my index within the writer/reader half */
+    const size_t half_threads = (num_threads + 1) >> 1;
+    const size_t elems = bytes / 4;
+    uint32_t *dp = (uint32_t *)dst;
+    const uint32_t *sp = (const uint32_t *)src;
+    uint64_t acc = 0;
+    for (size_t off = 0; off < elems; off += half_threads) {
+        const size_t i = lane + off;
+        if (i < elems) {
+            if (writer) {
+                dp[i] = seed ^ (uint32_t)i;
+            } else {
+                acc += sp[i];
+            }
+        }
+    }
+    if (acc == 0xdeadbeefdeadbeefULL) {
+        dp[0] = (uint32_t)acc; /* never taken */
+    }
+}
+
+/* Host-side one-shot probe (see the block in allreduce_large_fp8_ring). */
+template <typename Launch>
+static void fp8ar_run_probe(sycl::queue &q,
+                            int rank,
+                            void *remote_slot,
+                            void *local_slot,
+                            size_t half_bytes,
+                            size_t work_group_size,
+                            Launch launch_threads,
+                            uint32_t *scratch) {
+    constexpr int warm = 5;
+    constexpr int reps = 20;
+    const size_t region = half_bytes - 16; /* keep the scale area clear */
+    uint8_t *remote_first = (uint8_t *)remote_slot;
+    uint8_t *remote_second = remote_first + half_bytes;
+    uint8_t *local_first = (uint8_t *)local_slot;
+
+    auto run = [&](const char *name, size_t width, int mode) {
+        /* mode: 0 = remote write, 1 = remote read, 2 = remote rw,
+         *       3 = local write, 4 = local read */
+        if (width > 8 && ((uintptr_t)remote_first % width) != 0) {
+            fprintf(stderr, "FP8AR_PROBE rank%d %-14s SKIP (unaligned %p)\n",
+                    rank, name, remote_first);
+            return;
+        }
+        const size_t elems = region / width;
+        const size_t kernel_size = launch_threads(elems);
+        auto submit = [&]() {
+            switch (mode) {
+                case 0:
+                    q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                                   [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                                       fp8ar_probe_write_kernel(remote_first, region, width, 0xa5a5a5a5u);
+                                   });
+                    break;
+                case 1:
+                    q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                                   [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                                       fp8ar_probe_read_kernel(remote_second, region, width, scratch);
+                                   });
+                    break;
+                case 2:
+                    q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                                   [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                                       fp8ar_probe_rw_kernel(remote_first, remote_second, region, 0x5a5a5a5au);
+                                   });
+                    break;
+                case 3:
+                    q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                                   [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                                       fp8ar_probe_write_kernel(local_first, region, width, 0xa5a5a5a5u);
+                                   });
+                    break;
+                default:
+                    q.parallel_for(sycl::nd_range<1>(kernel_size, work_group_size),
+                                   [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+                                       fp8ar_probe_read_kernel(local_first + half_bytes, region, width, scratch);
+                                   });
+                    break;
+            }
+        };
+        for (int r = 0; r < warm; r++) submit();
+        q.wait();
+        auto t0 = std::chrono::steady_clock::now();
+        for (int r = 0; r < reps; r++) submit();
+        q.wait();
+        const double ms =
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0)
+                .count();
+        const double gbs = region * (double)reps / (ms * 1e6);
+        fprintf(stderr,
+                "FP8AR_PROBE rank%d %-14s %6.2f MB width=%2zuB : %7.2f GB/s (%.3f ms/rep)\n",
+                rank,
+                name,
+                region / 1048576.0,
+                width,
+                gbs,
+                ms / reps);
+        fflush(stderr);
+    };
+
+    run("remote_write4", 4, 0);
+    run("remote_write8", 8, 0);
+    run("remote_write16", 16, 0);
+    run("remote_read4", 4, 1);
+    run("remote_read8", 8, 1);
+    run("remote_read16", 16, 1);
+    run("remote_rw4", 4, 2);
+    run("local_write4", 4, 3);
+    run("local_read4", 4, 4);
+}
