+def _tensor_from_xpu_ptr(
+    ptr: int,
+    shape: tuple[int, ...],
+    dtype: torch.dtype,
+    device: torch.device,
+    total_bytes: int,
+) -> torch.Tensor:
+    """Create a non-owning XPU (SYCL USM) tensor from a raw device pointer.
+
+    torch._C._construct_storage_from_data_pointer takes a signed 64-bit
+    pointer; XPU USM device addresses arrive as unsigned values that can
+    exceed 2**63, so wrap them into the signed range first. Aliasing is
+    verified: writes through the returned tensor land in the original
+    allocation.
+    """
+    try:
+        signed_ptr = ptr if ptr < 2**63 else ptr - 2**64
+        storage = torch._C._construct_storage_from_data_pointer(
+            signed_ptr,
+            device,
+            total_bytes,
+        )
+        tensor = torch.empty(0, dtype=dtype, device=storage.device)
+        tensor.set_(storage, 0, shape, _contiguous_element_strides(shape))
+        return tensor
+    except Exception as exc:
+        raise RuntimeError(
+            "TorchXPU failed to construct a non-owning tensor from a device pointer"
+        ) from exc
+
